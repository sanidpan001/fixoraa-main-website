FTY","HEIST","HELIX","HENCE","HENNA","HERON","HERTZ","HINGE","HIPPO","HIPPY","HITCH","HOARD","HOARY","HOIST","HOLLY","HOMEY","HONKY","HOOEY","HORSY","HOTLY","HOUND","HOVEL","HOVER","HOWDY","HUFFY","HUMID","HUMUS","HUNCH","HUNKY","HUSKY","HUSSY","HUTCH","HYDRA","HYDRO","HYENA","HYMEN","HYPER"];

/* ================= Daily Word — game logic (vanilla JS) ================= */
(function () {
  'use strict';

  var ROWS = 6, COLS = 5;
  var GUESS_SET = new Set(VALID_GUESSES);

  function $(id) { return document.getElementById(id); }
  var boardEl = $('board'), kbEl = $('keyboard'), toastEl = $('toast'), overlay = $('overlay');

  /* ---- Seeded PRNG: same word for everyone, each calendar day ---- */
  function hashStr(s) {
    var h = 1779033703 ^ s.length;
    for (var i = 0; i < s.length; i++) {
      h = Math.imul(h ^ s.charCodeAt(i), 3432918353);
      h = (h << 13) | (h >>> 19);
    }
    return h >>> 0;
  }
  function mulberry32(a) {
    return function () {
      a |= 0; a = (a + 0x6D2B79F5) | 0;
      var t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function dateKey() {
    var d = new Date();
    return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
  }
  function epochDay() { return Math.floor(Date.now() / 86400000); }
  var PUZZLE_NO = epochDay() - Math.floor(new Date(2026, 0, 1).getTime() / 86400000);
  function dailyAnswer() {
    var rnd = mulberry32(hashStr('dailyword-' + epochDay()));
    return ANSWERS[Math.floor(rnd() * ANSWERS.length)];
  }
  function randomAnswer() {
    return ANSWERS[Math.floor(Math.random() * ANSWERS.length)];
  }

  /* ---- State ---- */
  var mode = 'daily';            // 'daily' | 'practice'
  var answer = '', guesses = [], marks = [];
  var row = 0, cur = '', over = false, counted = false;

  function dailyStoreKey() { return 'dailyword-daily-' + dateKey(); }
  function saveDaily() {
    if (mode !== 'daily') return;
    try {
      localStorage.setItem(dailyStoreKey(), JSON.stringify({ answer: answer, guesses: guesses, marks: marks, over: over, counted: counted }));
    } catch (e) {}
  }
  function loadDaily() {
    try {
      var raw = localStorage.getItem(dailyStoreKey());
      if (!raw) return false;
      var s = JSON.parse(raw);
      if (!s || s.answer !== dailyAnswer()) return false;
      guesses = s.guesses || []; marks = s.marks || [];
      row = guesses.length; over = !!s.over; counted = !!s.counted;
      return true;
    } catch (e) { return false; }
  }

  /* ---- Stats (daily mode only) ---- */
  function getStats() {
    try {
      var s = JSON.parse(localStorage.getItem('dailyword-stats'));
      if (s && typeof s.played === 'number') return s;
    } catch (e) {}
    return { played: 0, wins: 0, streak: 0, maxStreak: 0, dist: [0, 0, 0, 0, 0, 0] };
  }
  function setStats(s) {
    try { localStorage.setItem('dailyword-stats', JSON.stringify(s)); } catch (e) {}
  }

  /* ---- Board rendering ---- */
  var tiles = [];
  function buildBoard() {
    boardEl.innerHTML = '';
    tiles = [];
    for (var r = 0; r < ROWS; r++) {
      tiles[r] = [];
      for (var c = 0; c < COLS; c++) {
        var t = document.createElement('div');
        t.className = 'tile';
        t.setAttribute('aria-label', 'Row ' + (r + 1) + ' letter ' + (c + 1));
        boardEl.appendChild(t);
        tiles[r][c] = t;
      }
    }
  }
  function paintRow(r) {
    // Repaint letters of the active row while typing
    for (var c = 0; c < COLS; c++) {
      var t = tiles[r][c];
      t.textContent = cur[c] || '';
      t.classList.toggle('filled', !!cur[c]);
    }
  }

  /* ---- On-screen keyboard ---- */
  var KB_ROWS = ['QWERTYUIOP', 'ASDFGHJKL', 'ZXCVBNM'];
  var keyState = {}; // letter -> 'correct' | 'present' | 'absent'
  var keyEls = {};
  function buildKeyboard() {
    kbEl.innerHTML = '';
    keyEls = {};
    KB_ROWS.forEach(function (r, ri) {
      var rowEl = document.createElement('div');
      rowEl.className = 'kb-row';
      if (ri === 2) {
        var enter = makeKey('ENTER', 'key-wide', 'Enter');
        rowEl.appendChild(enter);
      }
      for (var i = 0; i < r.length; i++) {
        rowEl.appendChild(makeKey(r[i], '', r[i]));
      }
      if (ri === 2) {
        rowEl.appendChild(makeKey('BACK', 'key-wide', '⌫'));
      }
      kbEl.appendChild(rowEl);
    });
  }
  function makeKey(label, cls, action) {
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'key ' + cls;
    b.textContent = label;
    b.setAttribute('aria-label', action === 'BACK' ? 'Backspace' : action === 'Enter' ? 'Enter' : 'Letter ' + label);
    b.addEventListener('click', function () { press(action); });
    if (/^[A-Z]$/.test(action)) keyEls[action] = b;
    return b;
  }
  var RANK = { absent: 0, present: 1, correct: 2 };
  function updateKeyboard() {
    keyState = {};
    for (var g = 0; g < guesses.length; g++) {
      for (var i = 0; i < COLS; i++) {
        var L = guesses[g][i], m = marks[g][i];
        if (!keyState[L] || RANK[m] > RANK[keyState[L]]) keyState[L] = m;
      }
    }
    Object.keys(keyEls).forEach(function (L) {
      var el = keyEls[L];
      el.classList.remove('correct', 'present', 'absent');
      if (keyState[L]) el.classList.add(keyState[L]);
    });
  }

  /* ---- Toast + shake ---- */
  var toastTimer = null;
  function toast(msg, ms) {
    toastEl.textContent = msg;
    toastEl.classList.remove('hidden');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(function () { toastEl.classList.add('hidden'); }, ms || 1400);
  }
  function shakeRow(r) {
    var rowTiles = tiles[r];
    rowTiles.forEach(function (t) { t.classList.add('shake'); });
    setTimeout(function () { rowTiles.forEach(function (t) { t.classList.remove('shake'); }); }, 600);
  }

  /* ---- Guess scoring: standard duplicate-letter handling ---- */
  function scoreGuess(guess, ans) {
    var res = [], counts = {}, i;
    for (i = 0; i < COLS; i++) res[i] = 'absent';
    for (i = 0; i < COLS; i++) {
      if (guess[i] === ans[i]) res[i] = 'correct';
      else counts[ans[i]] = (counts[ans[i]] || 0) + 1;
    }
    for (i = 0; i < COLS; i++) {
      if (res[i] !== 'correct' && counts[guess[i]] > 0) {
        res[i] = 'present';
        counts[guess[i]]--;
      }
    }
    return res;
  }

  /* ---- Input ---- */
  function press(k) {
    if (over) return;
    if (k === 'Enter') { submitGuess(); return; }
    if (k === 'BACK') {
      if (cur.length > 0) { cur = cur.slice(0, -1); paintRow(row); sfx.click(); }
      return;
    }
    if (/^[A-Z]$/.test(k) && cur.length < COLS) {
      cur += k;
      paintRow(row);
      sfx.key(); // soft blip per typed letter
      var t = tiles[row][cur.length - 1];
      t.classList.remove('pop');
      void t.offsetWidth; // restart animation
      t.classList.add('pop');
    }
  }
  document.addEventListener('keydown', function (e) {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (!overlay.classList.contains('hidden')) {
      if (e.key === 'Escape') closeOverlay();
      return;
    }
    if (e.key === 'Enter') press('Enter');
    else if (e.key === 'Backspace') press('BACK');
    else if (/^[a-zA-Z]$/.test(e.key)) press(e.key.toUpperCase());
  });

  /* ---- Submit with flip animation ---- */
  var PRAISE = ['Genius!', 'Magnificent!', 'Impressive!', 'Splendid!', 'Great!', 'Phew!'];
  function submitGuess() {
    if (over || row >= ROWS) return;
    if (cur.length < COLS) { toast('Not enough letters'); shakeRow(row); return; }
    if (!GUESS_SET.has(cur)) { toast('Not in word list'); shakeRow(row); return; }

    var guess = cur, r = row;
    var m = scoreGuess(guess, answer);
    guesses.push(guess);
    marks.push(m);
    cur = '';
    row++;

    // Flip tiles one by one, revealing color at the halfway point
    for (var i = 0; i < COLS; i++) {
      (function (i) {
        var t = tiles[r][i];
        setTimeout(function () {
          t.classList.add('reveal');
          sfx.flip(); // staggered flip blip, one per tile
          setTimeout(function () {
            t.classList.remove('filled');
            t.classList.add(m[i]);
            t.style.color = '#fff';
          }, 250);
        }, i * 300);
      })(i);
    }

    var won = guess === answer;
    var totalDelay = COLS * 300 + 350;
    setTimeout(function () {
      updateKeyboard();
      if (won) onWin();
      else if (row >= ROWS) onLose();
      else saveDaily();
    }, totalDelay);
  }

  function onWin() {
    over = true;
    toast(PRAISE[Math.min(guesses.length, 6) - 1], 2000);
    if (mode === 'daily' && !counted) {
      counted = true;
      var s = getStats();
      s.played++; s.wins++; s.streak++;
      s.maxStreak = Math.max(s.maxStreak, s.streak);
      s.dist[guesses.length - 1]++;
      setStats(s);
    }
    saveDaily();
    setTimeout(function () { showOverlay(true); }, 1300);
  }
  function onLose() {
    over = true;
    toast('The word was ' + answer, 2500);
    if (mode === 'daily' && !counted) {
      counted = true;
      var s = getStats();
      s.played++; s.streak = 0;
      setStats(s);
    }
    saveDaily();
    setTimeout(function () { showOverlay(false); }, 1300);
  }

  /* ---- Overlay: result, stats, share, countdown ---- */
  function showOverlay(won) {
    var s = getStats();
    $('ov-title').textContent = won ? '🎉 You got it!' : '😅 So close!';
    $('ov-answer').textContent = answer;
    $('st-played').textContent = s.played;
    $('st-winpct').textContent = s.played ? Math.round((s.wins / s.played) * 100) : 0;
    $('st-streak').textContent = s.streak;
    $('st-max').textContent = s.maxStreak;

    var distEl = $('ov-dist');
    distEl.innerHTML = '';
    var max = Math.max.apply(null, s.dist.concat([1]));
    s.dist.forEach(function (n, i) {
      var wrap = document.createElement('div');
      wrap.className = 'flex items-center gap-2 text-xs font-bold';
      var label = document.createElement('span');
      label.className = 'w-3 text-zinc-500';
      label.textContent = (i + 1);
      var bar = document.createElement('div');
      var highlight = won && guesses.length === i + 1;
      bar.className = 'rounded px-2 py-0.5 text-white ' + (highlight ? 'bg-gradient-to-r from-[#FF5A5F] to-[#9333EA]' : 'bg-zinc-400');
      bar.style.minWidth = '1.75rem';
      bar.style.width = Math.max(8, (n / max) * 100) + '%';
      bar.style.textAlign = 'right';
      bar.textContent = n;
      wrap.appendChild(label);
      wrap.appendChild(bar);
      distEl.appendChild(wrap);
    });

    var isDaily = mode === 'daily';
    $('ov-countdown-wrap').classList.toggle('hidden', !isDaily);
    $('ov-next-practice').classList.toggle('hidden', isDaily);
    overlay.classList.remove('hidden');
    overlay.classList.add('flex');
    if (isDaily) tickCountdown();
  }
  function closeOverlay() {
    overlay.classList.add('hidden');
    overlay.classList.remove('flex');
  }

  var countdownTimer = null;
  function tickCountdown() {
    clearInterval(countdownTimer);
    function update() {
      var now = new Date();
      var mid = new Date(now);
      mid.setHours(24, 0, 0, 0);
      var diff = Math.max(0, mid - now);
      var h = Math.floor(diff / 3600000), m = Math.floor((diff % 3600000) / 60000), s = Math.floor((diff % 60000) / 1000);
      $('ov-countdown').textContent =
        String(h).padStart(2, '0') + ':' + String(m).padStart(2, '0') + ':' + String(s).padStart(2, '0');
    }
    update();
    countdownTimer = setInterval(update, 1000);
  }

  /* ---- Share: emoji grid + clipboard ---- */
  function emojiFor(m) { return m === 'correct' ? '🟩' : m === 'present' ? '🟨' : '⬛'; }
  function shareResult() {
    var head = mode === 'daily'
      ? 'Daily Word #' + PUZZLE_NO + ' ' + (over && guesses[guesses.length - 1] === answer ? guesses.length : 'X') + '/6'
      : 'Daily Word (Practice) ' + guesses.length + '/6';
    var lines = marks.map(function (m) { return m.map(emojiFor).join(''); });
    var text = head + '\n\n' + lines.join('\n') + '\n\nPlay free: https://fixoraa.tech/games/daily-word';
    function done() { toast('Result copied! 📋', 1800); }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(text); done(); });
    } else { fallbackCopy(text); done(); }
  }
  function fallbackCopy(text) {
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
  }

  /* ---- Mode switching / new game ---- */
  function paintModeButtons() {
    var d = $('mode-daily'), p = $('mode-practice');
    var active = 'bg-white shadow text-zinc-950', idle = 'text-zinc-500';
    d.className = 'mode-btn rounded-full px-5 py-2 transition ' + (mode === 'daily' ? active : idle);
    p.className = 'mode-btn rounded-full px-5 py-2 transition ' + (mode === 'practice' ? active : idle);
    $('puzzle-no').textContent = mode === 'daily' ? 'Puzzle #' + PUZZLE_NO + ' · ' + dateKey() : 'Practice · unlimited words';
    $('btn-new-practice').classList.toggle('hidden', mode !== 'practice');
  }
  function newGame(m) {
    mode = m;
    answer = (m === 'daily') ? dailyAnswer() : randomAnswer();
    guesses = []; marks = []; row = 0; cur = ''; over = false; counted = false;
    var restored = (m === 'daily') ? loadDaily() : false;
    if (!restored && m === 'daily') { /* fresh daily */ }
    buildBoard();
    buildKeyboard();
    // Repaint restored guesses instantly (no animation)
    for (var g = 0; g < guesses.length; g++) {
      for (var i = 0; i < COLS; i++) {
        var t = tiles[g][i];
        t.textContent = guesses[g][i];
        t.classList.add(marks[g][i]);
        t.style.color = '#fff';
      }
    }
    updateKeyboard();
    paintModeButtons();
    closeOverlay();
  }

  /* ---- Wire up ---- */
  $('mode-daily').addEventListener('click', function () { newGame('daily'); });
  $('mode-practice').addEventListener('click', function () { newGame('practice'); });
  $('btn-new-practice').addEventListener('click', function () { newGame('practice'); });
  $('btn-stats').addEventListener('click', function () {
    // Show stats overlay without ending the game: reuse overlay in "peek" mode
    var wasOver = over;
    over = true; // prevent input while peeking
    var keepAnswer = $('ov-answer').textContent;
    showOverlay(false);
    $('ov-title').textContent = '📊 Your stats';
    $('ov-answer').textContent = wasOver ? keepAnswer : (mode === 'daily' ? '?????' : '?????');
    if (!wasOver) { over = false; }
  });
  $('btn-how').addEventListener('click', function () {
    document.getElementById('howto').scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
  $('ov-share').addEventListener('click', shareResult);
  $('ov-close').addEventListener('click', closeOverlay);
  overlay.addEventListener('click', function (e) { if (e.target === overlay) closeOverlay(); });
  $('ov-next-practice').addEventListener('click', function () { newGame('practice'); });

  /* ---- Go ---- */
  newGame('daily');
})();
</script>
<style>
  .grad-text {
    background: linear-gradient(100deg, #FF5A5F, #F43F8E 40%, #9333EA 70%, #2E6BFF);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  /* ---- Tiles ---- */
  .tile {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.9rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #18181b;
    background: #fff;
    border: 2px solid #d4d4d8;
    user-select: none;
  }
  .tile.filled { border-color: #a1a1aa; }
  .tile.pop { animation: pop 0.12s ease; }
  @keyframes pop {
    0% { transform: scale(0.85); }
    60% { transform: scale(1.08); }
    100% { transform: scale(1); }
  }
  .tile.reveal { animation: flip 0.6s ease forwards; }
  @keyframes flip {
    0% { transform: rotateX(0); }
    50% { transform: rotateX(-90deg); }
    100% { transform: rotateX(0); }
  }
  .tile.shake { animation: shake 0.5s ease; border-color: #f43f5e; }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-8px); }
    40% { transform: translateX(8px); }
    60% { transform: translateX(-6px); }
    80% { transform: translateX(6px); }
  }
  .tile.correct { background: #6aaa64; border-color: #6aaa64; }
  .tile.present { background: #c9b458; border-color: #c9b458; }
  .tile.absent  { background: #8b8b93; border-color: #8b8b93; }
  .mini-tile {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2rem; height: 2rem; font-weight: 800; font-size: 1rem; color: #fff;
  }
  .mini-tile.correct { background: #6aaa64; }
  .mini-tile.present { background: #c9b458; }
  .mini-tile.absent  { background: #8b8b93; }
  /* ---- Keyboard ---- */
  .kb-row {
    display: flex;
    gap: 4px;
    justify-content: center;
    margin-bottom: 6px;
    touch-action: manipulation;
