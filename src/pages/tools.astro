---
import Layout from '../layouts/Layout.astro';
import { niches, allTools, totalTools, newTools } from '../data/tools';

const sortedTools = [...allTools].sort((a, b) => a.name.localeCompare(b.name));
const withAdded = sortedTools.map((t) => ({ ...t, added: newTools[t.slug] ?? null }));
const toolsJson = JSON.stringify(withAdded);
const isNewTool = (t: { slug: string }) => { const d = newTools[t.slug]; if (!d) return false; const days = (Date.now() - new Date(d + 'T00:00:00').getTime()) / 86400000; return days >= 0 && days < 5; };
const isSoon = (url: string) => url.includes('PASTE-YOUR-TOOL-URL-HERE');

const guideIntros: Record<string, string> = {
  'finance-calculators': "Money questions rarely need a spreadsheet — they need one honest number, fast. This category covers the full arc of personal finance: loan EMIs and payoff timelines, SIP and RD growth, income tax and GST, retirement corpus planning, and the small daily maths of budgets, discounts and salary breakup. Every calculator shows its working, so you can change an assumption — a rate, a tenure, a monthly amount — and see the effect instantly. Start with the EMI and SIP tools if you are planning something big, and keep the everyday converters handy for everything else.",
  'image-tools': "Images are where file size, quality and format collide. Here you will find compressors that shrink photos for forms and WhatsApp without visible quality loss, converters between JPG, PNG, WebP and AVIF, resizers and croppers for exact dimensions, and small creative editors for backgrounds, filters and collages. Everything runs in your browser, so your photos never get uploaded to a server — the edit happens on your own device. Whether you are preparing a passport photo, a product shot for your shop, or a profile picture, start here.",
  'pdf-tools': "The PDF is the world's default document — and the hardest to change. This category gives you the everyday operations: merge several files into one, split a long document apart, compress a heavy scan down to email size, convert to and from Word and images, rotate, reorder and protect pages. Files are processed without accounts or watermarks, and outputs come out clean and shareable. If a form, an application or an office task has ever bounced back with 'please upload a single PDF', these are the tools that fix it.",
  'text-tools': "Writers, students and social-media managers live in text. This category handles the mechanical half of writing: word and character counters for limits that matter, case converters, duplicate line removers, text sorters and reversers, fancy-text and hashtag helpers, and small analysers that check readability and frequency. Paste, clean, copy — most jobs take under ten seconds. The tools are deliberately simple: one input, one obvious action, and output you can trust, so the words stay yours and only the busywork disappears.",
  'developer-tools': "Small utilities that remove small frictions, fifty times a day. Formatters and validators for JSON, a regex tester that explains matches, encoders for Base64 and URLs, UUID and password generators, CSS helpers for gradients, shadows and clamp values, and viewers that make raw data readable. Everything runs locally in your browser — tokens, payloads and snippets never leave your machine, which is exactly how a debugging helper should behave. Bookmark the ones your stack needs; they will quietly save you hours every month.",
  'date-time': "Dates look simple until time zones, working days and deadlines get involved. This category calculates ages to the day, counts down to events, adds or subtracts days across holidays, converts between time zones, and turns timestamps into human-readable moments. Useful for HR letters, project plans, exam timetables, visa paperwork and anyone who has ever asked 'how many days until…?' and needed the answer to be exactly right — not approximately right.",
  'health-fitness': "You cannot improve what you do not measure. These trackers and calculators cover BMI and healthy weight ranges, daily calorie and protein needs, pace and step conversions for runners and walkers, sleep-cycle timing, and simple logs that turn intentions into streaks. They are general-information tools — quick, private and judgment-free — meant to help you notice patterns and set sensible targets. For anything medical, they point you to a professional; for everything everyday, they give you a clear number to start from.",
  'fun-lifestyle': "Not everything has to be productive. This is the playful shelf: quizzes that test flags, vocab and memory, generators for names, stories and party games, wheels and dice for fair decisions, and tiny daily challenges that make a phone break feel like a game again. Teachers use them in classrooms, friends use them in group chats, and creators use them when an idea refuses to arrive. Everything is instant, free and safe to share — pick one and give your brain a different kind of exercise.",
  'converters': "Units are a translation problem, and this category is the translator. Length, weight, temperature, area, speed, data size, cooking measures, shoe and clothing sizes, number systems and more — each converter is built for one job, with both directions one tap apart and results shown as you type. No sign-up walls between you and a number: the kind of tool you open from a search result, use in five seconds, and leave satisfied. Keep it in mind for shopping, travel, study and DIY.",
  'study-career': "Exams and job hunts reward preparation that is organised, not just long. Here you will find study planners and flashcard-style helpers, percentage and grade calculators, resume and cover-letter builders, typing and vocabulary practice, and interview-prep tools that turn anxiety into rehearsal. Students use them to plan revision against real dates; job seekers use them to leave with a sharper resume than they arrived with. Small tools, serious outcomes — that is the point of this shelf.",
};
---
<Layout title="All Free Online Tools — Fixoraa" description="Browse every free Fixoraa tool: calculators, converters, PDF tools, text tools, developer utilities and more. Search the full directory. No signup, no watermarks.">
<main class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
  <!-- Header -->
  <div class="text-center mb-8">
    <span class="inline-block text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full text-white bg-gradient-to-r from-[#FF5A5F] via-[#F43F8E] to-[#9333EA] mb-4">Free · No signup</span>
    <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-neutral-900">Every Fixoraa <span class="bg-gradient-to-r from-[#FF5A5F] via-[#F43F8E] to-[#9333EA] bg-clip-text text-transparent">tool</span></h1>
    <p class="mt-4 text-neutral-600 max-w-2xl mx-auto">One directory for everything. Search by name or topic, filter by category, and jump straight to the tool you need.</p>
  </div>

  <!-- Search -->
  <div class="max-w-xl mx-auto mb-6">
    <div class="relative">
      <svg class="absolute left-4 top-1/2 -translate-y-1/2 h-5 w-5 text-neutral-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input id="toolSearch" type="search" placeholder="Search tools — try “tax”, “pdf”, “sleep”…" aria-label="Search tools"
        class="w-full rounded-2xl border border-neutral-200 bg-white pl-11 pr-4 py-3.5 text-neutral-900 placeholder:text-neutral-400 shadow-sm focus:outline-none focus:ring-2 focus:ring-[#9333EA]/50 focus:border-[#9333EA]" />
    </div>
  </div>

  <!-- Niche filter chips -->
  <div id="nicheChips" class="flex flex-wrap justify-center gap-2 mb-4">
    <button data-niche="all" class="chip chip-active">All</button>
    <button data-niche="new" class="chip">✨ New</button>
    {niches.map((n) => (
      <button data-niche={n.slug} class="chip">{n.name}</button>
    ))}
  </div>

  <!-- Results count -->
  <p id="resultCount" class="text-center text-sm text-neutral-500 mb-8">Showing {totalTools} of {totalTools} tools</p>

  <!-- Grid -->
  <div id="toolGrid" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {sortedTools.map((t) => (
      <div class="tool-card" data-name={t.name.toLowerCase()} data-blurb={t.blurb.toLowerCase()} data-niche={t.niche.toLowerCase()} data-nicheslug={t.nicheSlug}>
        {isSoon(t.url) ? (
          <div class="relative block h-full rounded-2xl bg-white border border-neutral-200 p-5 opacity-70">
            <span class="inline-block text-[11px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full bg-[#9333EA]/10 text-[#9333EA] mb-3">{t.niche}</span>
            <h3 class="text-lg font-bold text-neutral-900 pr-6">{t.name}</h3>
            <p class="text-sm text-neutral-600 mt-1">{t.blurb}</p>
            <span class="inline-block mt-3 text-xs font-bold px-3 py-1 rounded-full bg-neutral-100 text-neutral-500">Coming soon</span>
          </div>
        ) : (
          <a href={t.url} target="_blank" rel="noopener" class="group relative block h-full rounded-2xl bg-white border border-neutral-200 p-5 hover:shadow-lg hover:-translate-y-1 hover:border-neutral-300 transition-all">
            <span class="inline-block text-[11px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full bg-[#9333EA]/10 text-[#9333EA] mb-3">{t.niche}</span>{isNewTool(t) && <span class="new-badge">New</span>}
            <h3 class="text-lg font-bold text-neutral-900 pr-6">{t.name}</h3>
            <p class="text-sm text-neutral-600 mt-1">{t.blurb}</p>
            <span class="absolute top-5 right-5 text-xl text-neutral-400 group-hover:text-[#9333EA] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    ))}
  </div>

  <!-- Empty state -->
  <div id="emptyState" class="hidden text-center py-16">
    <p class="text-5xl mb-4">🔍</p>
    <h2 class="text-xl font-bold text-neutral-900 mb-2">No tools found</h2>
    <p class="text-neutral-600">Try a different search term or category.</p>
  </div>

  <!-- Browse by category -->
  <div class="mt-16 rounded-3xl bg-[#FAFAF8] border border-neutral-200 p-6 sm:p-8">
    <h2 class="text-2xl font-black text-neutral-900 mb-4">Browse by category</h2>
    <div class="grid gap-3 sm:grid-cols-2">
      {niches.map((n) => (
        <button data-jump={n.slug} class="text-left rounded-2xl bg-white border border-neutral-200 p-4 hover:shadow-md hover:-translate-y-0.5 transition-all">
          <span class="font-bold text-neutral-900">{n.name}</span>
          <span class="block text-sm text-neutral-500 mt-1">{n.tools.length} tools · {n.tagline}</span>
        </button>
      ))}
    </div>
  </div>

  <!-- Category guides (added 2026-10-15) -->
  <div class="mt-16">
    <h2 class="text-2xl font-black text-neutral-900 mb-2">Category guides</h2>
    <p class="text-neutral-600 mb-6 max-w-3xl">New here, or not sure which tool fits your task? Each guide explains a category in plain language — what the tools do, when to use which one, and the favourites to start with.</p>
    <div class="grid gap-4 sm:grid-cols-2">
      {niches.map((n) => (
        <a href={`/categories/${n.slug}`} class="block rounded-3xl border border-neutral-200 bg-white p-6 hover:shadow-lg hover:-translate-y-0.5 transition-all">
          <span class="font-black text-lg text-neutral-900">{n.name}</span>
          <span class="block text-xs font-bold uppercase tracking-widest text-neutral-400 mt-1">{n.tools.length} tools</span>
          <span class="block text-sm text-neutral-600 leading-relaxed mt-3">{guideIntros[n.slug]}</span>
          <span class="mt-4 inline-block text-sm font-bold text-[#9333EA]">Read the guide →</span>
        </a>
      ))}
    </div>
  </div>
</main>

<style>
  .chip {
    font-size: .875rem; font-weight: 600; padding: .5rem 1rem; border-radius: 9999px;
    border: 1px solid #e5e5e5; background: #fff; color: #404040; cursor: pointer;
    transition: all .15s ease;
  }
  .chip:hover { border-color: #a3a3a3; }
  .chip-active {
    color: #fff; border-color: transparent;
    background: linear-gradient(to right, #FF5A5F, #F43F8E, #9333EA);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / .1);
  }
  .new-badge {
    display: inline-block; margin-left: .5rem; vertical-align: middle;
    font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    padding: .25rem .6rem; border-radius: 9999px; color: #fff;
    background: linear-gradient(to right, #FF5A5F, #F43F8E, #9333EA);
    box-shadow: 0 2px 4px rgb(0 0 0 / .12);
  }
  /* ── Dark mode (:global so it matches <html data-theme>) ── */
  :global([data-theme="dark"] .chip) { background: #131a28; border-color: #2a3350; color: #cbd5e1; }
  :global([data-theme="dark"] .chip:hover) { border-color: #475569; }
  :global([data-theme="dark"] .chip.chip-active) {
    background: linear-gradient(to right, #FF5A5F, #F43F8E, #9333EA);
    border-color: transparent; color: #fff;
  }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .tool-card { animation: fadeUp .35s ease both; }
</style>

<script define:vars={{ toolsJson }}>
  const tools = JSON.parse(toolsJson);
  const grid = document.getElementById('toolGrid');
  const search = document.getElementById('toolSearch');
  const count = document.getElementById('resultCount');
  const empty = document.getElementById('emptyState');
  const chips = [...document.querySelectorAll('#nicheChips .chip')];
  const total = tools.length;
  let activeNiche = 'all';

  const esc = (s) => s.replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  const isPlaceholder = (u) => u.includes('PASTE-YOUR-TOOL-URL-HERE');
  const isFresh = (d) => { if (!d) return false; const days = (Date.now() - new Date(d + 'T00:00:00').getTime()) / 86400000; return days >= 0 && days < 5; };
  const tag = (n) => `<span class="inline-block text-[11px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full bg-[#9333EA]/10 text-[#9333EA] mb-3">${esc(n)}</span>`;
  const body = (t) => `${tag(t.niche)}${isFresh(t.added) ? '<span class="new-badge">New</span>' : ''}<h3 class="text-lg font-bold text-neutral-900 pr-6">${esc(t.name)}</h3><p class="text-sm text-neutral-600 mt-1">${esc(t.blurb)}</p>`;

  function cardHtml(t) {
    if (isPlaceholder(t.url)) {
      return `<div class="tool-card"><div class="relative block h-full rounded-2xl bg-white border border-neutral-200 p-5 opacity-70">${body(t)}<span class="inline-block mt-3 text-xs font-bold px-3 py-1 rounded-full bg-neutral-100 text-neutral-500">Coming soon</span></div></div>`;
    }
    return `<div class="tool-card"><a href="${esc(t.url)}" target="_blank" rel="noopener" class="group relative block h-full rounded-2xl bg-white border border-neutral-200 p-5 hover:shadow-lg hover:-translate-y-1 hover:border-neutral-300 transition-all">${body(t)}<span class="absolute top-5 right-5 text-xl text-neutral-400 group-hover:text-[#9333EA] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" aria-hidden="true">↗</span></a></div>`;
  }

  function render() {
    const q = search.value.trim().toLowerCase();
    let filtered = tools.filter((t) =>
      (activeNiche === 'all' || (activeNiche === 'new' ? isFresh(t.added) : t.nicheSlug === activeNiche)) &&
      (!q || t.name.toLowerCase().includes(q) || t.blurb.toLowerCase().includes(q) || t.niche.toLowerCase().includes(q))
    );
    if (activeNiche === 'new') filtered.sort((a, b) => (b.added || '').localeCompare(a.added || '') || a.name.localeCompare(b.name));
    grid.innerHTML = filtered.map(cardHtml).join('');
    empty.classList.toggle('hidden', filtered.length > 0);
    grid.classList.toggle('hidden', filtered.length === 0);
    count.textContent = `Showing ${filtered.length} of ${total} tools`;
  }

  search.addEventListener('input', render);
  chips.forEach((chip) => chip.addEventListener('click', () => {
    chips.forEach((c) => c.classList.remove('chip-active'));
    chip.classList.add('chip-active');
    activeNiche = chip.dataset.niche;
    render();
  }));
  // Category cards below the grid jump to the matching filter
  document.querySelectorAll('[data-jump]').forEach((btn) => btn.addEventListener('click', () => {
    const chip = chips.find((c) => c.dataset.niche === btn.dataset.jump);
    if (chip) chip.click();
    grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
  render();
</script>
</Layout>
