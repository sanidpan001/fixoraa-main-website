---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact Us — Fixoraa" description="Contact Fixoraa: suggest a tool, report a bug, or just say hello. We read every message. Email hello@fixoraa.tech.">
<main class="mx-auto max-w-2xl px-4 py-10 sm:py-14">
  <!-- Header -->
  <div class="text-center mb-10">
    <span class="inline-block text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full text-white bg-gradient-to-r from-[#FF5A5F] via-[#F43F8E] to-[#9333EA] mb-4">Contact</span>
    <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-neutral-900">Say <span class="bg-gradient-to-r from-[#FF5A5F] via-[#F43F8E] to-[#9333EA] bg-clip-text text-transparent">hello</span></h1>
    <p class="mt-4 text-neutral-600">Tool idea, bug report, or just feedback — we read every single message.</p>
  </div>

  <!-- Email card -->
  <a href="mailto:hello@fixoraa.tech" class="block rounded-3xl bg-[#FAFAF8] border border-neutral-200 p-6 text-center mb-8 hover:shadow-md hover:border-neutral-300 transition-all">
    <p class="text-sm font-semibold text-neutral-500 mb-1">Prefer email? Write to us directly</p>
    <p class="text-xl sm:text-2xl font-black text-neutral-900">hello@fixoraa.tech</p>
  </a>

  <!-- Form -->
  <form id="contactForm" class="rounded-3xl bg-white border border-neutral-200 p-6 sm:p-8 shadow-sm" novalidate>
    <div class="grid gap-5">
      <div>
        <label for="cf-name" class="block text-sm font-bold text-neutral-900 mb-1.5">Your name</label>
        <input id="cf-name" name="name" type="text" required autocomplete="name" placeholder="Jane Doe"
          class="w-full rounded-2xl border border-neutral-200 px-4 py-3 text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#9333EA]/50 focus:border-[#9333EA]" />
      </div>
      <div>
        <label for="cf-email" class="block text-sm font-bold text-neutral-900 mb-1.5">Email address</label>
        <input id="cf-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com"
          class="w-full rounded-2xl border border-neutral-200 px-4 py-3 text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#9333EA]/50 focus:border-[#9333EA]" />
      </div>
      <div>
        <label for="cf-message" class="block text-sm font-bold text-neutral-900 mb-1.5">Message</label>
        <textarea id="cf-message" name="message" rows="5" required placeholder="What's on your mind?"
          class="w-full rounded-2xl border border-neutral-200 px-4 py-3 text-neutral-900 placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-[#9333EA]/50 focus:border-[#9333EA] resize-y"></textarea>
      </div>
      <button type="submit" id="cf-submit"
        class="rounded-2xl px-6 py-3.5 font-bold text-white bg-gradient-to-r from-[#FF5A5F] via-[#F43F8E] to-[#9333EA] hover:opacity-90 hover:shadow-lg transition-all disabled:opacity-60">
        Send message
      </button>
      <p id="cf-status" class="hidden text-sm rounded-2xl px-4 py-3" role="status" aria-live="polite"></p>
    </div>
  </form>

  <p class="mt-6 text-center text-sm text-neutral-500">We usually reply within a couple of days.</p>
</main>

<!--
  ─────────────────────────────────────────────────────────────────────
  FORM WIRING — READ THIS BEFORE GOING LIVE
  ─────────────────────────────────────────────────────────────────────
  The contact form above is NOT connected to any backend yet. To make
  it actually send messages, do the following (takes ~5 minutes):

  1. Sign up free at https://formspree.io (FormSubmit at
     https://formsubmit.co is a free alternative).
  2. Create a new form and copy its endpoint URL. It looks like:
        https://formspree.io/f/your-form-id
  3. Paste that URL into the FORM_ENDPOINT constant in the <script>
     below (and uncomment the fetch block).

  Until then, the form shows a friendly notice directing visitors to
  email hello@fixoraa.tech instead of silently failing.
  ─────────────────────────────────────────────────────────────────────
-->
<script>
  // PASTE YOUR FORMSPREE (or FormSubmit) ENDPOINT HERE — e.g.:
  //   const FORM_ENDPOINT = "https://formspree.io/f/your-form-id";
  // Sign up at https://formspree.io, create a form, and paste its endpoint URL.
  const FORM_ENDPOINT = "";

  const form = document.getElementById('contactForm');
  const status = document.getElementById('cf-status');
  const submitBtn = document.getElementById('cf-submit');

  function showStatus(message, ok) {
    status.textContent = message;
    status.className = 'text-sm rounded-2xl px-4 py-3 ' + (ok
      ? 'bg-green-50 text-green-800 border border-green-200'
      : 'bg-amber-50 text-amber-900 border border-amber-200');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }

    // Backend not configured yet — never pretend the message was sent.
    if (!FORM_ENDPOINT) {
      showStatus('Form backend not connected yet — email us at hello@fixoraa.tech and we\u2019ll get back to you.', false);
      return;
    }

    // ── Uncomment the block below once FORM_ENDPOINT is set: ──
    /*
    submitBtn.disabled = true;
    try {
      const res = await fetch(FORM_ENDPOINT, {
        method: 'POST',
        headers: { 'Accept': 'application/json', 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: document.getElementById('cf-name').value.trim(),
          email: document.getElementById('cf-email').value.trim(),
          message: document.getElementById('cf-message').value.trim(),
        }),
      });
      if (!res.ok) throw new Error('send failed');
      form.reset();
      showStatus('Message sent! We\u2019ll get back to you soon.', true);
    } catch {
      showStatus('Something went wrong sending your message — please email us at hello@fixoraa.tech instead.', false);
    } finally {
      submitBtn.disabled = false;
    }
    */
  });
</script>
</Layout>
