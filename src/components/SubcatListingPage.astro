---
// Paginated sub-category listing page (added 2026-11-20, 700k rollout).
// Renders ONE page (100 tools) of a sub-category under
// /categories/<category>/<subcategory>/ with the same card design as the
// /tools listings, plus numbered pagination so every tool stays
// reachable (and crawlable) through real <a href> links.
import Layout from '../layouts/Layout.astro';
import {
  getSubcategories,
  isFresh,
  isPlaceholderUrl,
  type Subcategory,
} from '../lib/tools-data';

interface PageLike {
  data: any[];
  currentPage: number;
  lastPage: number;
  total: number;
  url: { prev?: string; next?: string };
}

interface Props {
  subcat: Subcategory;
  page: PageLike;
}

const { subcat, page } = Astro.props as Props;
const tools = page.data;
const total = page.total;
const perPage = 100;
const start = total === 0 ? 0 : (page.currentPage - 1) * perPage + 1;
const end = (page.currentPage - 1) * perPage + tools.length;
const base = `/categories/${subcat.categorySlug}/${subcat.slug}/`;
const pageHref = (n: number) => (n === 1 ? base : `${base}${n}/`);

const siblings = getSubcategories().filter(
  (s) => s.categorySlug === subcat.categorySlug
);

// Mobile chip-row collapse (added 2026-11-21): on small screens the
// sibling chip row shows only the active chip plus the first 3 other
// chips, with a Show more/less toggle; chips beyond that are marked
// chip-extra and hidden by the media query in <style> below. Desktop
// always shows every chip and never shows the toggle.
let otherSeen = 0;
const chipItems = siblings.map((s) => {
  const active = s.slug === subcat.slug;
  const extra = !active && otherSeen++ >= 3;
  return { s, active, extra };
});
const hasExtraChips = chipItems.some((c) => c.extra);

// Windowed page numbers: 1 … c-2 c-1 c c+1 c+2 … N
const win: (number | '…')[] = [];
{
  const c = page.currentPage;
  const last = page.lastPage;
  const nums = new Set<number>([1, last, c - 2, c - 1, c, c + 1, c + 2]);
  let prev = 0;
  for (let n = 1; n <= last; n++) {
    if (!nums.has(n)) continue;
    if (prev && n - prev > 1) win.push('…');
    win.push(n);
    prev = n;
  }
}

const pageTitle =
  page.currentPage === 1
    ? `${subcat.name} — Free Online Tools | Fixoraa`
    : `${subcat.name} — Page ${page.currentPage} | Fixoraa`;
const pageDescription = `Browse ${total} free ${subcat.name} tools on Fixoraa — part of ${subcat.categoryName}. Page ${page.currentPage} of ${page.lastPage}. No signup, no watermarks.`;
---

<Layout title={pageTitle} description={pageDescription}>
<main class="mx-auto max-w-6xl px-4 py-10 sm:py-14">
  <!-- Breadcrumb -->
  <nav class="text-sm text-neutral-500 mb-6 text-center" aria-label="Breadcrumb">
    <a href="/tools" class="font-semibold text-[#9333EA] hover:underline">Tools</a>
    <span class="mx-1.5" aria-hidden="true">›</span>
    <a href={`/categories/${subcat.categorySlug}`} class="font-semibold text-[#9333EA] hover:underline">{subcat.categoryName}</a>
    <span class="mx-1.5" aria-hidden="true">›</span>
    <span class="text-neutral-700">{subcat.name}</span>
  </nav>

  <!-- Header (same design language as /tools) -->
  <div class="text-center mb-8">
    <span class="inline-block text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full text-white bg-gradient-to-r from-[#FF5A5F] via-[#F43F8E] to-[#9333EA] mb-4">Free · No signup</span>
    <h1 class="text-4xl sm:text-5xl font-black tracking-tight text-neutral-900">{subcat.name}</h1>
    <p class="mt-4 text-neutral-600 max-w-2xl mx-auto">
      {total} free tools in {subcat.name}, a sub-category of{' '}
      <a href={`/categories/${subcat.categorySlug}`} class="font-semibold text-[#9333EA] hover:underline">{subcat.categoryName}</a>.
      No signup, no watermarks.
    </p>
  </div>

  <!-- Sibling sub-category chips -->
  {siblings.length > 1 && (
    <div class="subcat-chips flex flex-wrap justify-center gap-2 mb-4" data-expanded="false">
      {chipItems.map(({ s, active, extra }) => (
        <a href={`/categories/${s.categorySlug}/${s.slug}/`} class={`chip ${active ? 'chip-active' : ''}${extra ? ' chip-extra' : ''}`}>{s.name}</a>
      ))}
      {hasExtraChips && (
        <button type="button" class="chip subcat-toggle" aria-expanded="false">Show more</button>
      )}
    </div>
  )}

  <!-- Results count -->
  <p class="text-center text-sm text-neutral-500 mb-8">
    {total === 0
      ? 'No tools here right now — check back soon.'
      : <>Showing {start}–{end} of {total} tools · Page {page.currentPage} of {page.lastPage}</>}
  </p>

  <!-- Grid (card markup identical to the /tools directory cards) -->
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {tools.map((t) => (
      <div class="tool-card" data-name={t.name.toLowerCase()} data-blurb={t.blurb.toLowerCase()} data-niche={t.niche.toLowerCase()} data-nicheslug={t.nicheSlug}>
        {isPlaceholderUrl(t.url) ? (
          <div class="relative block h-full rounded-2xl bg-white border border-neutral-200 p-5 opacity-70">
            <span class="inline-block text-[11px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full bg-[#9333EA]/10 text-[#9333EA] mb-3">{t.subcategory}</span>
            <h3 class="text-lg font-bold text-neutral-900 pr-6">{t.name}</h3>
            <p class="text-sm text-neutral-600 mt-1">{t.blurb}</p>
            <span class="inline-block mt-3 text-xs font-bold px-3 py-1 rounded-full bg-neutral-100 text-neutral-500">Coming soon</span>
          </div>
        ) : (
          <a href={t.url} target="_blank" rel="noopener" class="group relative block h-full rounded-2xl bg-white border border-neutral-200 p-5 hover:shadow-lg hover:-translate-y-1 hover:border-neutral-300 transition-all">
            <span class="inline-block text-[11px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full bg-[#9333EA]/10 text-[#9333EA] mb-3">{t.subcategory}</span>{isFresh(t.slug) && <span class="new-badge">✨ New</span>}
            <h3 class="text-lg font-bold text-neutral-900 pr-6">{t.name}</h3>
            <p class="text-sm text-neutral-600 mt-1">{t.blurb}</p>
            <span class="absolute top-5 right-5 text-xl text-neutral-400 group-hover:text-[#9333EA] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    ))}
  </div>

  <!-- Pagination -->
  {page.lastPage > 1 && (
    <nav class="mt-12 flex flex-wrap items-center justify-center gap-2" aria-label="Listing pages">
      {page.url.prev
        ? <a href={page.url.prev} class="chip" rel="prev">← Prev</a>
        : <span class="chip opacity-40 pointer-events-none">← Prev</span>}
      {win.map((n) => n === '…'
        ? <span class="px-1 text-neutral-400">…</span>
        : <a href={pageHref(n)} class={`chip ${n === page.currentPage ? 'chip-active' : ''}`} aria-current={n === page.currentPage ? 'page' : undefined}>{n}</a>)}
      {page.url.next
        ? <a href={page.url.next} class="chip" rel="next">Next →</a>
        : <span class="chip opacity-40 pointer-events-none">Next →</span>}
    </nav>
  )}

  <p class="mt-10 text-center text-sm text-neutral-500">
    Looking for something specific? <a href="/tools" class="font-bold text-[#9333EA] hover:underline">Search the full directory</a>
  </p>
</main>

<script>
  // Mobile-only sibling-chip toggle: instant show/hide of the extra
  // chips (no animation). The button itself is hidden on desktop by
  // the media query in <style> below, so this only ever fires on
  // small screens.
  document.querySelectorAll('.subcat-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const wrap = btn.closest('.subcat-chips');
      if (!wrap) return;
      const expanded = wrap.getAttribute('data-expanded') === 'true';
      wrap.setAttribute('data-expanded', expanded ? 'false' : 'true');
      btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      btn.textContent = expanded ? 'Show more' : 'Show less';
    });
  });
</script>

<style>
  .chip {
    display: inline-block; text-decoration: none;
    font-size: .875rem; font-weight: 600; padding: .5rem 1rem; border-radius: 9999px;
    border: 1px solid #e5e5e5; background: #fff; color: #404040; cursor: pointer;
    transition: all .15s ease;
  }
  .chip:hover { border-color: #a3a3a3; }
  .chip-active {
    color: #fff; border-color: transparent;
    background: linear-gradient(to right, #FF5A5F, #F43F8E, #9333EA);
    box-shadow: 0 4px 6px -1px rgb(0 0 0 / .1);
  }
  .new-badge {
    display: inline-block; margin-left: .5rem; vertical-align: middle;
    font-size: 11px; font-weight: 900; letter-spacing: .1em; text-transform: uppercase;
    padding: .35rem .75rem; border-radius: 9999px; color: #fff;
    background: linear-gradient(to right, #FF5A5F, #F43F8E, #9333EA);
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px #F43F8E, 0 6px 14px rgb(244 63 142 / .5);
    animation: newBadgePulse 1.6s ease-in-out infinite;
  }
  @keyframes newBadgePulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }
  :global([data-theme="dark"] .chip) { background: #131a28; border-color: #2a3350; color: #cbd5e1; }
  :global([data-theme="dark"] .chip:hover) { border-color: #475569; }
  :global([data-theme="dark"] .chip.chip-active) {
    background: linear-gradient(to right, #FF5A5F, #F43F8E, #9333EA);
    border-color: transparent; color: #fff;
  }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  .tool-card { animation: fadeUp .35s ease both; }
  /* Sibling-chip Show more/less toggle: mobile only (below the sm
     breakpoint, mirroring the site's Tailwind sm: convention). On
     desktop the button is never displayed and all chips stay visible.
     The active chip is pinned first on mobile so it is always in the
     visible set when the row is collapsed. Instant display toggle —
     no transitions. */
  .subcat-toggle { display: none; }
  @media (max-width: 639.98px) {
    .subcat-chips .chip-active { order: -1; }
    .subcat-chips[data-expanded="false"] .chip-extra { display: none; }
    .subcat-toggle { display: inline-block; order: 1; }
  }
</style>
</Layout>
