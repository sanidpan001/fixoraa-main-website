---
// ToolSearchBox — reusable task-style search bar (added 2026-11-22 on
// Sandipan's order: every category and sub-category page must carry a
// search bar, and search must answer task-style queries like
// "jpg to pdf" or "pdf editing", not only exact tool names).
// Uses the same lazy index + ranked search (searchTools) as the
// homepage search. One instance per page; the script wires every
// .fxsearch root it finds.
interface Props {
  placeholder?: string;
}
const {
  placeholder = 'Search by task or tool name… e.g. jpg to pdf, pdf editing, emi calculator',
} = Astro.props as Props;
---

<div class="fxsearch" role="search">
  <div class="fxsearch-box">
    <svg class="fxsearch-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2" />
      <path d="m20 20-3.8-3.8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <input
      class="fxsearch-input"
      type="text"
      autocomplete="off"
      maxlength="120"
      placeholder={placeholder}
      aria-label="Search tools by task or name"
    />
  </div>
  <div class="fxsearch-results" hidden></div>
</div>

<style is:global>
  /* is:global: result rows are created by JS at runtime, so Astro's
     scoped styles would never reach them. All classes are fxsearch-*
     prefixed, so going global is safe. */
  .fxsearch {
    position: relative;
    max-width: 36rem;
    margin: 0 auto;
  }
  .fxsearch-box {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 1px solid rgb(var(--ink) / 0.18);
    border-radius: 999px;
    padding: 12px 18px;
    background: rgb(var(--ink) / 0.04);
    color: rgb(var(--ink));
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .fxsearch-box:focus-within {
    border-color: #9333ea;
    box-shadow: 0 0 0 3px rgb(147 51 234 / 0.18);
  }
  .fxsearch-icon {
    width: 19px;
    height: 19px;
    flex: none;
    opacity: 0.55;
  }
  .fxsearch-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: inherit;
    font-size: 15px;
    outline: none;
  }
  .fxsearch-input::placeholder {
    color: rgb(var(--ink) / 0.45);
  }
  .fxsearch-results {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 60;
    border: 1px solid rgb(var(--ink) / 0.12);
    border-radius: 16px;
    background: rgb(var(--cream));
    color: rgb(var(--ink));
    box-shadow: 0 24px 50px -12px rgba(10, 10, 10, 0.35);
    overflow: hidden;
    text-align: left;
  }
  .fxsearch-results[hidden] {
    display: none;
  }
  .fxsearch-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 18px;
    text-decoration: none;
    color: inherit;
    transition: background 0.12s ease;
  }
  .fxsearch-row:hover {
    background: rgb(var(--ink) / 0.05);
  }
  .fxsearch-row + .fxsearch-row {
    border-top: 1px solid rgb(var(--ink) / 0.06);
  }
  .fxsearch-row-main {
    min-width: 0;
  }
  .fxsearch-row-name {
    display: block;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }
  .fxsearch-row-blurb {
    display: block;
    font-size: 12px;
    opacity: 0.6;
    margin-top: 1px;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fxsearch-row-tag {
    flex: none;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgb(var(--ink) / 0.07);
    opacity: 0.75;
  }
  .fxsearch-empty {
    padding: 14px 18px;
    font-size: 14px;
    opacity: 0.75;
  }
  .fxsearch-empty a {
    font-weight: 700;
    color: #9333ea;
    text-decoration: underline;
  }
</style>

<script>
  import { loadToolIndex, searchTools } from '../lib/search-client.js';

  document.querySelectorAll('.fxsearch').forEach((root) => {
    const input = root.querySelector('.fxsearch-input');
    const results = root.querySelector('.fxsearch-results');
    let tools = [];
    let started = false;

    function esc(s) {
      return String(s || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }
    function hide() {
      results.hidden = true;
      results.innerHTML = '';
    }
    function run() {
      const q = input.value.trim();
      if (q.length < 2) {
        hide();
        return;
      }
      const { list } = searchTools(tools, q, 8);
      if (!list.length) {
        results.innerHTML =
          '<p class="fxsearch-empty">No tools match &quot;' +
          esc(q) +
          '&quot;. Try a task word — like &quot;jpg to pdf&quot; — or <a href="/tools">browse all tools</a>.</p>';
      } else {
        results.innerHTML = list
          .map(
            (t) =>
              '<a class="fxsearch-row" href="' +
              esc(t.url) +
              '" target="_blank" rel="noopener"><span class="fxsearch-row-main"><span class="fxsearch-row-name">' +
              esc(t.name) +
              '</span><span class="fxsearch-row-blurb">' +
              esc(t.blurb) +
              '</span></span><span class="fxsearch-row-tag">' +
              esc(t.niche || '') +
              '</span></a>'
          )
          .join('');
      }
      results.hidden = false;
    }
    function ensure() {
      if (started) return;
      started = true;
      loadToolIndex((loaded) => {
        tools = loaded;
        run();
      });
    }
    input.addEventListener('input', () => {
      ensure();
      run();
    });
    input.addEventListener('focus', () => {
      ensure();
      if (input.value.trim().length >= 2) run();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        hide();
        input.blur();
      }
    });
    input.addEventListener('blur', () => {
      setTimeout(hide, 180);
    });
  });
</script>
