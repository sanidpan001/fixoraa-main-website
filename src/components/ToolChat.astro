---
// Fixoraa Tool Finder — AI chat widget (added 2026-11-22 on Sandipan's order).
// Floating draggable icon, bottom-right. The visitor describes what they
// need (any language); the Groq backend turns it into English search
// phrases, a word-level ranker over the site's own lazy search index
// (src/lib/search-client.js) builds a candidate list, and the AI makes
// the final pick from those candidates. Falls back to the ranked list
// if an AI call fails or times out. All widget text is English; visitors
// can type in any language. No ads, no tracking beyond the site tracker.
---

<div id="fxchat" class="fxchat" aria-live="polite">
 <div id="fxchat-anchor" class="fxchat-anchor">
  <button
    id="fxchat-fab"
    class="fxchat-fab"
    type="button"
    aria-label="Open the Fixoraa tool finder chat"
    aria-haspopup="dialog"
    aria-expanded="false"
    title="Find a tool — drag to move"
  >
    <svg class="fxchat-fab-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path
        d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5Z"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
    </svg>
    <span class="fxchat-fab-dot" aria-hidden="true"></span>
  </button>

  <button id="fxchat-hint" class="fxchat-hint" type="button" aria-label="Find your tool here — open the tool finder chat">Find your tool here</button>
 </div>

  <section
    id="fxchat-panel"
    class="fxchat-panel"
    role="dialog"
    aria-modal="false"
    aria-label="Fixoraa tool finder"
    hidden
  >
    <header class="fxchat-head">
      <span class="fxchat-avatar" aria-hidden="true">∞</span>
      <div class="fxchat-head-text">
        <strong>Tool Finder</strong>
        <span>Tell me your task — I will find the right tool from 10 lakh+ tools</span>
      </div>
      <button id="fxchat-close" class="fxchat-close" type="button" aria-label="Close chat">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/></svg>
      </button>
    </header>

    <div id="fxchat-msgs" class="fxchat-msgs" data-lenis-prevent></div>

    <div id="fxchat-chips" class="fxchat-chips" data-lenis-prevent>
      <button type="button" class="fxchat-chip">Merge two PDFs</button>
      <button type="button" class="fxchat-chip">Calculate my loan EMI</button>
      <button type="button" class="fxchat-chip">Compress an image</button>
      <button type="button" class="fxchat-chip">Build my resume</button>
      <button type="button" class="fxchat-chip">Convert JPG to PNG</button>
      <button type="button" class="fxchat-chip">Count words in my text</button>
    </div>

    <form id="fxchat-form" class="fxchat-form">
      <input
        id="fxchat-input"
        class="fxchat-input"
        type="text"
        autocomplete="off"
        maxlength="300"
        placeholder="Type your problem in any language… e.g. merge two PDFs"
        aria-label="Describe what you need a tool for"
      />
      <button id="fxchat-send" class="fxchat-send" type="submit" aria-label="Send">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M22 2 11 13M22 2l-7 20-4-9-9-4 20-7Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </form>
    <p class="fxchat-note">AI-powered search · Please do not share passwords or personal files here.</p>
  </section>
</div>

<style is:global>
  /* is:global is required: chat messages and result cards are created
     by JS at runtime, so Astro's scoped styles would never reach them. */
  .fxchat {
    --fx-grad: linear-gradient(120deg, #ff5a5f 0%, #f43f8e 38%, #9333ea 70%, #2e6bff 100%);
    /* AI (bot) messages get their own clearly different colour from the
       visitor's gradient bubbles — soft lavender in light theme… */
    --fx-bot-bg: #ece7fa;
    --fx-bot-ink: #251d4d;
    font-family: inherit;
  }
  /* …and a deep muted violet in the dark theme. */
  html[data-theme="dark"] .fxchat {
    --fx-bot-bg: #2e2752;
    --fx-bot-ink: #f0edfd;
  }
  /* The anchor is the fixed, draggable element; the FAB fills it
     and the hint pill hangs above it, so the pill follows the
     button everywhere — even to a drag-saved position. */
  .fxchat-anchor {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 90;
    width: 58px;
    height: 58px;
  }
  .fxchat-fab {
    position: absolute;
    inset: 0;
    width: 58px;
    height: 58px;
    border: none;
    border-radius: 50%;
    background-image: var(--fx-grad);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    box-shadow: 0 12px 30px -8px rgba(147, 51, 234, 0.55), 0 4px 12px rgba(10, 10, 10, 0.18);
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .fxchat-fab:hover { transform: translateY(-2px) scale(1.04); }
  .fxchat-fab:active { cursor: grabbing; }
  /* Blinking "Find your tool here" pill above the FAB (Sandipan's
     idea, 2026-11-22): tells visitors what the button does. Soft
     blink, never a hard strobe; hides for good once the chat has
     been opened (localStorage) so it never nags. */
  .fxchat-hint {
    position: absolute;
    right: 0;
    bottom: calc(100% + 12px);
    white-space: nowrap;
    border: none;
    cursor: pointer;
    padding: 9px 15px;
    border-radius: 999px;
    background-image: var(--fx-grad);
    color: #fff;
    font-size: 13.5px;
    font-weight: 800;
    letter-spacing: 0.01em;
    box-shadow: 0 10px 26px -8px rgba(147, 51, 234, 0.55);
    animation: fxhint-blink 1.5s ease-in-out infinite;
  }
  @keyframes fxhint-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .fxchat-hint-hide { display: none; }
  .fxchat-fab-icon { width: 29px; height: 29px; pointer-events: none; }
  .fxchat-fab-dot {
    position: absolute;
    top: 3px;
    right: 3px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #22c55e;
    border: 2px solid #fff;
    pointer-events: none;
    animation: fxchat-pulse 2.4s infinite;
  }
  @keyframes fxchat-pulse {
    0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.5); }
    70% { box-shadow: 0 0 0 7px rgba(34, 197, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }
  .fxchat-panel {
    position: fixed;
    right: 16px;
    bottom: 90px;
    z-index: 91;
    width: min(384px, calc(100vw - 24px));
    height: min(568px, calc(100dvh - 116px));
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background: rgb(var(--cream));
    color: rgb(var(--ink));
    border: 1px solid rgb(var(--ink) / 0.1);
    box-shadow: 0 24px 60px -12px rgba(10, 10, 10, 0.35);
    transform-origin: bottom right;
    animation: fxchat-in 0.22s ease;
  }
  .fxchat-panel[hidden] { display: none; }
  @keyframes fxchat-in {
    from { opacity: 0; transform: translateY(14px) scale(0.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .fxchat-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 14px;
    background-image: var(--fx-grad);
    color: #fff;
    flex: none;
  }
  .fxchat-avatar {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    font-weight: 800;
    flex: none;
  }
  .fxchat-head-text { display: flex; flex-direction: column; line-height: 1.25; min-width: 0; }
  .fxchat-head-text strong { font-size: 15.5px; font-weight: 800; letter-spacing: -0.01em; }
  .fxchat-head-text span { font-size: 11.5px; opacity: 0.92; }
  .fxchat-close {
    margin-left: auto;
    flex: none;
    width: 32px;
    height: 32px;
    border: none;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .fxchat-close svg { width: 17px; height: 17px; }
  .fxchat-msgs {
    flex: 1;
    overflow-y: auto;
    padding: 14px 12px 8px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    overscroll-behavior: contain;
  }
  .fxchat-msg {
    max-width: 88%;
    padding: 9px 12px;
    border-radius: 15px;
    font-size: 14px;
    line-height: 1.45;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .fxchat-msg.bot {
    align-self: flex-start;
    background: var(--fx-bot-bg);
    color: var(--fx-bot-ink);
    border-bottom-left-radius: 5px;
  }
  .fxchat-msg.user {
    align-self: flex-end;
    background-image: var(--fx-grad);
    color: #fff;
    border-bottom-right-radius: 5px;
  }
  .fxchat-msg.typing { display: inline-flex; gap: 5px; align-items: center; }
  .fxchat-msg.typing i {
    width: 7px; height: 7px; border-radius: 50%;
    background: currentColor;
    animation: fxchat-blink 1.1s infinite;
  }
  .fxchat-msg.typing i:nth-child(2) { animation-delay: 0.18s; }
  .fxchat-msg.typing i:nth-child(3) { animation-delay: 0.36s; }
  @keyframes fxchat-blink { 0%, 80%, 100% { opacity: 0.25; } 40% { opacity: 1; } }
  .fxchat-reqwrap {
    display: flex;
    margin: 2px 0 10px;
  }
  .fxchat-reqbtn {
    border: 1.5px solid #9333ea;
    cursor: pointer;
    background: var(--fx-bot-bg);
    color: var(--fx-bot-ink);
    font-weight: 800;
    font-size: 13.5px;
    padding: 10px 16px;
    border-radius: 12px;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .fxchat-reqbtn:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 20px -8px rgba(147, 51, 234, 0.5);
  }
  .fxchat-reqbtn:disabled {
    opacity: 0.6;
    cursor: default;
    transform: none;
    box-shadow: none;
  }
  .fxchat-results { display: flex; flex-direction: column; gap: 8px; align-self: stretch; }
  .fxchat-card {
    display: block;
    text-decoration: none;
    color: var(--fx-bot-ink);
    border: 1px solid rgb(var(--ink) / 0.1);
    border-radius: 14px;
    padding: 10px 12px;
    background: var(--fx-bot-bg);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .fxchat-card:hover { border-color: #9333ea; transform: translateY(-1px); }
  .fxchat-card strong { display: block; font-size: 14px; font-weight: 700; line-height: 1.3; }
  .fxchat-card span { display: block; font-size: 12px; opacity: 0.72; margin-top: 2px; line-height: 1.4; }
  .fxchat-card em {
    display: inline-block;
    font-style: normal;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #9333ea;
    margin-top: 6px;
  }
  .fxchat-catlinks { display: flex; flex-wrap: wrap; gap: 6px; align-self: stretch; }
  .fxchat-catlinks a {
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    color: inherit;
    border: 1px solid rgb(var(--ink) / 0.14);
    padding: 5px 10px;
    border-radius: 999px;
  }
  .fxchat-catlinks a:hover { border-color: #9333ea; color: #9333ea; }
  .fxchat-chips {
    flex: none;
    display: flex;
    gap: 6px;
    padding: 4px 12px 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .fxchat-chips::-webkit-scrollbar { display: none; }
  .fxchat-chip {
    flex: none;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 11px;
    border-radius: 999px;
    border: 1px solid rgb(var(--ink) / 0.14);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .fxchat-chip:hover { border-color: #f43f8e; color: #f43f8e; }
  .fxchat-form {
    flex: none;
    display: flex;
    gap: 8px;
    padding: 10px 12px 6px;
    border-top: 1px solid rgb(var(--ink) / 0.08);
  }
  .fxchat-input {
    flex: 1;
    min-width: 0;
    border: 1px solid rgb(var(--ink) / 0.14);
    background: transparent;
    color: inherit;
    border-radius: 999px;
    padding: 10px 15px;
    font-size: 14px;
    outline: none;
  }
  .fxchat-input:focus { border-color: #9333ea; }
  .fxchat-send {
    flex: none;
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 50%;
    background-image: var(--fx-grad);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .fxchat-send svg { width: 19px; height: 19px; margin-left: -2px; }
  .fxchat-send:disabled { opacity: 0.55; cursor: wait; }
  .fxchat-note {
    flex: none;
    text-align: center;
    font-size: 10.5px;
    opacity: 0.55;
    padding: 0 12px 9px;
    margin: 0;
  }
  @media (max-width: 480px) {
    .fxchat-panel { right: 12px; left: 12px; width: auto; bottom: 88px; }
    .fxchat-anchor { right: 16px; bottom: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fxchat-panel { animation: none; }
    .fxchat-fab-dot { animation: none; }
    .fxchat-hint { animation: none; }
  }
</style>

<script>
  import { loadToolIndex } from '../lib/search-client.js';

  const BACKEND = 'https://fixoraa-universal-backend.onrender.com/api/groq';
  const SYS_PROMPT =
    'You help visitors of Fixoraa, a directory of 10 lakh+ free online tools, find the right tool. ' +
    'The visitor describes a task or problem in any language (English, Hindi, Hinglish, etc.). ' +
    'Reply with ONLY a JSON array of 3 to 5 short English search phrases that would match tool names ' +
    'in the directory (for example: ["merge pdf", "combine pdf files", "pdf merger"]). ' +
    'No explanations, no markdown, only the JSON array.';

  const fab = document.getElementById('fxchat-fab');
  const anchor = document.getElementById('fxchat-anchor');
  const panel = document.getElementById('fxchat-panel');
  const closeBtn = document.getElementById('fxchat-close');
  const msgs = document.getElementById('fxchat-msgs');
  const form = document.getElementById('fxchat-form');
  const input = document.getElementById('fxchat-input');
  const sendBtn = document.getElementById('fxchat-send');
  const chips = document.getElementById('fxchat-chips');

  /* ---------- blinking hint pill ---------- */
  const hint = document.getElementById('fxchat-hint');
  function hideHint() {
    if (!hint || hint.classList.contains('fxchat-hint-hide')) return;
    hint.classList.add('fxchat-hint-hide');
    try { localStorage.setItem('fxchat-hint-seen', '1'); } catch (e) {}
  }
  if (hint) {
    try { if (localStorage.getItem('fxchat-hint-seen')) hint.classList.add('fxchat-hint-hide'); } catch (e) {}
    hint.addEventListener('click', () => { hideHint(); openPanel(); });
  }


  let greeted = false;
  let busy = false;

  /* ---------- panel open/close ---------- */
  function openPanel() {
    hideHint();
    panel.hidden = false;
    fab.setAttribute('aria-expanded', 'true');
    if (!greeted) {
      greeted = true;
      addBot(
        'Hi! I am Fixoraa\'s Tool Finder. Tell me your problem or task — like "merge two PDFs" or "make a photo smaller" — and I will find the right tool for you from 10 lakh+ tools. You can write in any language — English, Hindi, Hinglish or any other language — I understand them all and will find your tool.'
      );
    }
    loadToolIndex(() => {}); // warm the index in the background
    setTimeout(() => input.focus(), 60);
  }
  function closePanel() {
    panel.hidden = true;
    fab.setAttribute('aria-expanded', 'false');
  }
  closeBtn.addEventListener('click', closePanel);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) closePanel();
  });

  /* ---------- draggable FAB (click = open, drag = move) ---------- */
  (function makeDraggable() {
    let startX = 0, startY = 0, fabX = 0, fabY = 0, dragging = false, moved = false;
    try {
      const saved = JSON.parse(localStorage.getItem('fxchat-pos') || 'null');
      if (saved && typeof saved.x === 'number' && typeof saved.y === 'number') {
        placeFab(saved.x, saved.y);
      }
    } catch (e) {}
    function placeFab(x, y) {
      const maxX = window.innerWidth - anchor.offsetWidth - 6;
      const maxY = window.innerHeight - anchor.offsetHeight - 6;
      const cx = Math.max(6, Math.min(x, maxX));
      const cy = Math.max(6, Math.min(y, maxY));
      anchor.style.left = cx + 'px';
      anchor.style.top = cy + 'px';
      anchor.style.right = 'auto';
      anchor.style.bottom = 'auto';
    }
    fab.addEventListener('pointerdown', (e) => {
      hideHint();
      dragging = true;
      moved = false;
      const r = anchor.getBoundingClientRect();
      startX = e.clientX;
      startY = e.clientY;
      fabX = r.left;
      fabY = r.top;
      fab.setPointerCapture(e.pointerId);
    });
    fab.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (Math.abs(dx) + Math.abs(dy) > 7) moved = true;
      if (moved) placeFab(fabX + dx, fabY + dy);
    });
    fab.addEventListener('pointerup', () => {
      if (!dragging) return;
      dragging = false;
      if (moved) {
        const r = anchor.getBoundingClientRect();
        try {
          localStorage.setItem('fxchat-pos', JSON.stringify({ x: r.left, y: r.top }));
        } catch (e) {}
      } else {
        panel.hidden ? openPanel() : closePanel();
      }
    });
    window.addEventListener('resize', () => {
      if (fab.style.left) {
        const r = fab.getBoundingClientRect();
        placeFab(r.left, r.top);
      }
    });
  })();

  /* ---------- message rendering ---------- */
  function scrollDown() {
    msgs.scrollTop = msgs.scrollHeight;
  }
  function addUser(text) {
    const d = document.createElement('div');
    d.className = 'fxchat-msg user';
    d.textContent = text;
    msgs.appendChild(d);
    scrollDown();
  }
  function addBot(text) {
    const d = document.createElement('div');
    d.className = 'fxchat-msg bot';
    d.textContent = text;
    msgs.appendChild(d);
    scrollDown();
    return d;
  }
  function addTyping() {
    const d = document.createElement('div');
    d.className = 'fxchat-msg bot typing';
    d.innerHTML = '<i></i><i></i><i></i>';
    d.setAttribute('aria-label', 'Searching tools');
    msgs.appendChild(d);
    scrollDown();
    return d;
  }
  function esc(s) {
    return String(s || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }
  function renderCards(tools) {
    const wrap = document.createElement('div');
    wrap.className = 'fxchat-results';
    wrap.innerHTML = tools
      .map(
        (t) =>
          '<a class="fxchat-card" href="' +
          esc(t.url) +
          '"><strong>' +
          esc(t.name) +
          '</strong>' +
          (t.blurb ? '<span>' + esc(t.blurb) + '</span>' : '') +
          '<em>' +
          esc(t.subcategory || t.niche || 'Tool') +
          ' · Open tool →</em></a>'
      )
      .join('');
    msgs.appendChild(wrap);
    scrollDown();
    return wrap;
  }
  function renderCategoryLinks() {
    const cats = [
      ['PDF Tools', '/categories/pdf-tools/'],
      ['Image Tools', '/categories/image-tools/'],
      ['Finance', '/categories/finance-calculators/'],
      ['Converters', '/categories/converters/'],
      ['Text Tools', '/categories/text-tools/'],
      ['All Tools', '/tools'],
    ];
    const wrap = document.createElement('div');
    wrap.className = 'fxchat-catlinks';
    wrap.innerHTML = cats
      .map((c) => '<a href="' + c[1] + '">' + c[0] + '</a>')
      .join('');
    msgs.appendChild(wrap);
    scrollDown();
  }

  /* ---------- request-a-tool (Sandipan, 2026-11-22) ----------
     When no tool genuinely fits, the visitor can request it; the
     request lands in the same Formspree inbox as the contact form.
     Button + confirmation follow the visitor's language (sniffed). */
  const REQ_ENDPOINT = 'https://formspree.io/f/mgaoewnl';
  function sniffLang(text) {
    if (/[\u0900-\u097F]/.test(text)) return 'hi';
    const t = ' ' + String(text).toLowerCase().replace(/[^a-z\s]/g, ' ') + ' ';
    if (/( hai| hain| mujhe| mera| meri| karna| karo| chahiye| wala| wali| batao| dikhao| kaise| kahan| aur| nahi| bhi | liye| ek | do )/.test(t)) return 'hinglish';
    return 'en';
  }
  const REQ_TEXT = {
    en: {
      btn: '🛠 Request this tool',
      busy: 'Sending…',
      ok: 'Done! Your request has been noted. We build requested tools, so do check back soon — meanwhile, anything else I can find for you?',
      fail: 'Sorry, the request could not be sent. Please try again, or use the contact page on the site.',
    },
    hinglish: {
      btn: '🛠 Ye tool request karo',
      busy: 'Bhej raha hoon…',
      ok: 'Ho gaya! Tumhari request note kar li hai. Hum requested tools banate hain, kuch samay baad phir check karna — tab tak, kuch aur dhoondoon tumhare liye?',
      fail: 'Sorry, request nahi bhej paya. Phir se try karo, ya site ke contact page se bhej do.',
    },
    hi: {
      btn: '🛠 यह टूल अनुरोध करें',
      busy: 'भेज रहा हूँ…',
      ok: 'हो गया! आपका अनुरोध दर्ज कर लिया है। हम अनुरोध किए गए टूल बनाते हैं, कुछ समय बाद फिर देखें — तब तक, कुछ और खोजूँ आपके लिए?',
      fail: 'क्षमा करें, अनुरोध नहीं भेज पाया। फिर से प्रयास करें, या साइट के संपर्क पेज से भेजें।',
    },
  };
  const FOLLOW_TEXT = {
    en: 'Need anything else? Just tell me — I will search again.',
    hinglish: 'Kuch aur chahiye? Bas bata do — main phir dhoond dunga.',
    hi: 'कुछ और चाहिए? बस बता दीजिए — मैं फिर खोज दूँगा।',
  };
  const GOT_TEXT = {
    en: 'Got it! Here are the best matching tools:',
    hinglish: 'Samajh gaya! Tumhare liye sabse sahi tools ye rahe:',
    hi: 'समझ गया! आपके लिए सबसे सही टूल ये रहे:',
  };
  function renderRequestButton(userText, lang) {
    const T = REQ_TEXT[lang] || REQ_TEXT.en;
    const wrap = document.createElement('div');
    wrap.className = 'fxchat-reqwrap';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'fxchat-reqbtn';
    btn.textContent = T.btn;
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btn.textContent = T.busy;
      try {
        const resp = await fetch(REQ_ENDPOINT, {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify({
            _subject: 'Tool request from Fixoraa chat',
            source: 'Fixoraa Tool Finder chat',
            requested_tool: userText,
            language: lang,
            page: location.href,
          }),
        });
        if (!resp.ok) throw new Error('send failed');
        wrap.remove();
        addBot(T.ok);
      } catch (e) {
        btn.disabled = false;
        btn.textContent = T.btn;
        addBot(T.fail);
      }
    });
    wrap.appendChild(btn);
    msgs.appendChild(wrap);
    scrollDown();
  }

  /* ---------- search + ranking (v2: word-level matching) ---------- */
  const STOP = new Set(
    'the a an to of for me my i want need hai hain karna karo karni mujhe mera meri ek do please tool tools online free ka ki ke se aur or and in on ko wala wali liye batao dikhao chahiye kahan kaise bhi'.split(' ')
  );
  function wordsOf(s) {
    return (String(s || '').toLowerCase().match(/[a-z0-9]+/g) || []);
  }
  // Word match: exact, or a shared prefix for words of 4+ letters
  // (merge~merging, calculate~calculator) — never a loose substring,
  // so "emi" can no longer match "reminding".
  function wm(q, w) {
    if (q === w) return true;
    if (q.length >= 4 && w.length >= 4 && (q.startsWith(w) || w.startsWith(q))) return true;
    return false;
  }
  function coverage(phraseWords, targetWords) {
    if (!phraseWords.length) return 0;
    let hit = 0;
    for (const q of phraseWords) {
      if (targetWords.some((w) => wm(q, w))) hit++;
    }
    return hit / phraseWords.length;
  }
  // Per-tool word lists, computed once per loaded index.
  let wordCache = null;
  function buildWordCache(tools) {
    wordCache = tools.map((t) => ({
      nw: wordsOf(t.name),
      sw: wordsOf(t.subcategory || ''),
    }));
  }
  // Returns { cands, topName }: up to 36 candidates — the best name
  // matches first, then extra candidates found through their blurbs
  // (brand-named tools like ShrinkPro are only findable that way).
  function buildCandidates(tools, phrases, rawText) {
    if (!wordCache || wordCache.length !== tools.length) buildWordCache(tools);
    const pws = phrases
      .map((p) => wordsOf(p).filter((w) => w.length >= 2 && !STOP.has(w)))
      .filter((a) => a.length);
    const rawToks = [...new Set(wordsOf(rawText).filter((w) => w.length >= 3 && !STOP.has(w)))];
    const blurbWords = [...new Set([...pws.flat(), ...rawToks])].filter((w) => w.length >= 4).slice(0, 8);
    const byName = [];
    const blurbHits = [];
    for (let i = 0; i < tools.length; i++) {
      const t = tools[i];
      const { nw, sw } = wordCache[i];
      let ns = 0;
      let nameHit = false;
      for (const pw of pws) {
        const c = coverage(pw, nw);
        if (c >= 0.5) {
          ns += c * 20;
          if (c === 1) ns += 6;
          nameHit = true;
        }
      }
      for (const q of rawToks) {
        if (nw.some((w) => wm(q, w))) {
          ns += 4;
          nameHit = true;
        }
      }
      for (const pw of pws) {
        const c = coverage(pw, sw);
        if (c >= 0.5) ns += c * 5;
      }
      // Brand-named tools (ResumeForge, ShrinkPro) often carry the
      // exact task phrase only in their blurb — reward that so they
      // are not buried under hundreds of name-matching calculators.
      if (nameHit) {
        const bl = (t.blurb || '').toLowerCase();
        for (const p of phrases) {
          const ps = String(p).toLowerCase().trim();
          if (ps.length >= 8 && bl.includes(ps)) { ns += 10; break; }
        }
      }
      if (nameHit) byName.push([ns, t]);
      if (blurbWords.length) {
        const bl = (t.blurb || '').toLowerCase();
        let bs = 0;
        for (const q of blurbWords) if (bl.includes(q)) bs++;
        if (bs >= 2) blurbHits.push([bs, t]);
      }
    }
    const byOrd = (a, b) => b[0] - a[0] || (a[1].ord || 0) - (b[1].ord || 0);
    byName.sort(byOrd);
    blurbHits.sort(byOrd);
    const seen = new Set();
    const out = [];
    function push(arr, cap) {
      const perSub = {};
      for (const [, t] of arr) {
        if (out.length >= cap) break;
        if (seen.has(t.slug)) continue;
        const k = t.subcategory || '';
        perSub[k] = perSub[k] || 0;
        if (perSub[k] >= 3) continue;
        perSub[k]++;
        seen.add(t.slug);
        out.push(t);
      }
    }
    push(byName, 22);
    const nameCount = out.length;
    // Blurb pool: keep only tools whose blurb word-matches at least 2
    // query words, word-checked properly (the includes() pass above is
    // just a cheap prefilter).
    if (blurbHits.length) {
      const checked = [];
      for (const [bs, t] of blurbHits.slice(0, 800)) {
        const bw = wordsOf(t.blurb || '');
        let real = 0;
        for (const q of blurbWords) if (bw.some((w) => wm(q, w))) real++;
        if (real >= 2) checked.push([real, t]);
      }
      checked.sort(byOrd);
      push(checked, 36);
    }
    return { cands: out, nameCount, topName: byName.length ? byName[0][0] : 0 };
  }

  async function groqCall(messages, timeoutMs, maxTokens) {
    const ctrl = new AbortController();
    const timer = setTimeout(() => ctrl.abort(), timeoutMs);
    try {
      const res = await fetch(BACKEND, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        signal: ctrl.signal,
        body: JSON.stringify({
          model: 'openai/gpt-oss-20b',
          messages,
          max_tokens: maxTokens || 4000,
          reasoning_effort: 'low',
        }),
      });
      if (!res.ok) throw new Error('backend ' + res.status);
      const data = await res.json();
      return data && data.choices && data.choices[0] && data.choices[0].message
        ? data.choices[0].message.content || ''
        : '';
    } finally {
      clearTimeout(timer);
    }
  }
  function parseJsonSlice(content, open, close) {
    const start = content.indexOf(open);
    const end = content.lastIndexOf(close);
    if (start < 0 || end <= start) return null;
    try {
      return JSON.parse(content.slice(start, end + 1));
    } catch (e) {
      return null;
    }
  }
  async function aiPhrases(text) {
    try {
      const content = await groqCall(
        [
          { role: 'system', content: SYS_PROMPT },
          { role: 'user', content: text },
        ],
        12000
      );
      let arr = parseJsonSlice(content, '[', ']');
      if (!Array.isArray(arr)) {
        const start = content.indexOf('[');
        const end = content.lastIndexOf(']');
        if (start >= 0 && end > start) {
          arr = (content.slice(start, end + 1).match(/"([^"]+)"/g) || []).map((q) =>
            q.replace(/"/g, '')
          );
        }
      }
      if (!Array.isArray(arr)) return null;
      const phrases = arr
        .map((x) => String(x).toLowerCase().trim())
        .filter((x) => x.length >= 2 && x.length <= 60)
        .slice(0, 5);
      return phrases.length ? phrases : null;
    } catch (e) {
      return null;
    }
  }
  const PICK_PROMPT =
    'You are the Fixoraa Tool Finder. A visitor described a task. From the candidate tool list, ' +
    'pick the tools that GENUINELY do that task — read the descriptions carefully: many candidates ' +
    'are only calculators ABOUT a topic, not tools that do it; prefer real utility tools over ' +
    '"calculation time / cost for professionals" calculators. ' +
    'LANGUAGE RULE: write the reply in the SAME language and script as the visitor\'s message — ' +
    'English message → English reply; Hinglish (Hindi written in Roman letters) → Hinglish reply; ' +
    'Hindi in Devanagari script → Hindi (Devanagari) reply; any other language → that language. ' +
    'Keep tool names in English exactly as given. ' +
    'CRITICAL LANGUAGE RULE: if the visitor\'s message contains Hindi words written in Roman ' +
    'letters (words like mujhe, karna, hai, hain, chahiye, mera, batao, dikhao, kaise), your reply ' +
    'MUST be in HINGLISH — Hindi written in Roman letters, like "Samajh gaya! Ye tool abhi Fixoraa ' +
    'par nahi hai, aap neeche diye gaye Request button se ise maang sakte hain." — NOT in English ' +
    'and NEVER in Devanagari script. Only use Devanagari when the visitor wrote in Devanagari. ' +
    'Reply with ONLY a JSON object: ' +
    '{"reply":"<one or two short friendly lines in the visitor\'s language>","picks":[<candidate numbers, best first, up to 6>]}. ' +
    'If none of the candidates genuinely fit, picks must be [] and the reply must honestly say this ' +
    'exact tool is not on Fixoraa yet AND explain that the visitor can tap the "Request this tool" ' +
    'button below to request it — requested tools get built.';
  async function aiPick(text, cands) {
    try {
      const list = cands
        .map((t, i) => i + '. ' + t.name + ' — ' + (t.blurb || '') + ' [' + (t.subcategory || t.niche || '') + ']')
        .join('\n');
      const content = await groqCall(
        [
          { role: 'system', content: PICK_PROMPT },
          { role: 'user', content: 'Visitor: ' + text + '\n\nCandidates:\n' + list },
        ],
        12000,
        2000
      );
      const obj = parseJsonSlice(content, '{', '}');
      if (!obj || !Array.isArray(obj.picks)) return null;
      const picks = [];
      for (const n of obj.picks) {
        const i = Number(n);
        if (Number.isInteger(i) && i >= 0 && i < cands.length && !picks.includes(i)) picks.push(i);
        if (picks.length >= 6) break;
      }
      return {
        reply: typeof obj.reply === 'string' && obj.reply.trim() ? obj.reply.trim().slice(0, 320) : null,
        picks,
      };
    } catch (e) {
      return null;
    }
  }

  /* ---------- send flow ---------- */
  async function handleSend(text) {
    if (busy || !text) return;
    busy = true;
    sendBtn.disabled = true;
    addUser(text);
    const lang = sniffLang(text);
    const typing = addTyping();
    try {
      const toolsPromise = loadToolIndex(() => {}); // load in parallel with the AI call
      const phrases = await aiPhrases(text);
      const tools = await toolsPromise;
      const { cands, nameCount } = buildCandidates(tools, phrases || [], text);
      if (!cands.length) {
        typing.remove();
        addBot(
          'Sorry, I could not find a tool for that. Try describing the task with different words — for example "EMI calculator" or "compress PDF" — or browse by category:'
        );
        renderCategoryLinks();
        renderRequestButton(text, lang);
        return;
      }
      const nameCands = cands.slice(0, nameCount);
      const pick = phrases ? await aiPick(text, cands) : null;
      typing.remove();
      if (pick && pick.picks.length) {
        if (pick.reply) addBot(pick.reply);
        else addBot(GOT_TEXT[lang]);
        renderCards(pick.picks.map((i) => cands[i]));
        addBot(FOLLOW_TEXT[lang]);
      } else if (pick && !pick.picks.length && nameCands.length) {
        // The AI says no candidate truly does this task — be honest,
        // but still show the closest name matches.
        if (pick.reply) addBot(pick.reply);
        else addBot('I could not find an exact tool for that yet. These are the closest matches:');
        renderCards(nameCands.slice(0, 4));
        renderRequestButton(text, lang);
        addBot('Or browse all tools by category:');
        renderCategoryLinks();
      } else if (nameCands.length) {
        addBot(GOT_TEXT[lang]);
        renderCards(nameCands.slice(0, 6));
        addBot(FOLLOW_TEXT[lang]);
      } else {
        addBot('I could not find an exact tool for that yet.');
        renderRequestButton(text, lang);
        addBot('Or browse all tools by category:');
        renderCategoryLinks();
      }
    } catch (e) {
      typing.remove();
      addBot(
        'Something went wrong while searching. Please try again in a moment, or browse all tools by category:'
      );
      renderCategoryLinks();
    } finally {
      busy = false;
      sendBtn.disabled = false;
      input.focus();
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const text = input.value.trim();
    if (!text) return;
    input.value = '';
    handleSend(text);
  });
  chips.addEventListener('click', (e) => {
    const b = e.target.closest('.fxchat-chip');
    if (b) handleSend(b.textContent.trim());
  });
</script>
